    "PSUBank": "NIFTY PSU BANK",
    "Realty": "NIFTY REALTY",
    "Services": "NIFTY SERVICES SECTOR"
  },
  "filters": {
    "global": {
      "min_price_inr": 20,
      "min_avg_turnover_cr": 5,
      "min_avg_volume_20d": 100000,
      "ema_periods": [
        11,
        20,
        50
      ],
      "min_data_days": 200
    },
    "vcp": {
      "max_from_52wk_high_pct": 20,
      "min_pole_pct": 25,
      "pole_lookback_days": 126,
      "min_base_days": 15,
      "max_base_days": 60,
      "max_contraction_ratio": 0.2,
      "max_tight_range_pct": 0.08,
      "tight_window_days": 10,
      "require_volume_dry_up": true
    },
    "flag_pole": {
      "min_pole_pct": 20,
      "max_pole_days": 25,
      "min_retracement_pct": 15,
      "max_retracement_pct": 50,
      "min_flag_days": 5,
      "max_flag_days": 20,
      "max_flag_range_pct": 0.15,
      "min_price_in_flag_pct": 0.6,
      "volume_ratio_max": 0.8
    },
    "big_base": {
      "min_base_days": 30,
      "max_base_days": 120,
      "max_from_base_high_pct": 5,
      "min_prior_move_pct": 30,
      "prior_move_lookback": 126,
      "max_base_range_pct": 40,
      "min_base_range_pct": 10,
      "min_support_tests": 2,
      "support_zone_pct": 3
    }
  },
  "market_signals": {
    "weights": {
      "quantitative": 60,
      "qualitative": 40
    },
    "quantitative": {
      "nifty_vs_20w_sma": {
        "enabled": true,
        "weight": 30,
        "description": "Nifty 50 above 20-week SMA = broad uptrend"
      },
      "nifty_vs_50w_sma": {
        "enabled": true,
        "weight": 20,
        "description": "Nifty 50 above 50-week SMA = long term trend intact"
      },
      "india_vix": {
        "enabled": true,
        "weight": 25,
        "calm_below": 15,
        "fearful_above": 20,
        "description": "VIX below 15 = calm, above 20 = fearful"
      },
      "vix_direction": {
        "enabled": true,
        "weight": 10,
        "description": "Falling VIX = fear reducing = bullish"
      },
      "nifty_momentum": {
        "enabled": true,
        "weight": 15,
        "description": "Nifty 3M RS vs itself \u2014 is market accelerating"
      }
    },
    "qualitative": {
      "enabled": true,
      "search_queries": {
        "fii_dii_flows": {
          "query": "FII DII flows Indian stock market this week",
          "weight": 20,
          "sectors": [
            "ALL"
          ]
        },
        "rbi_policy": {
          "query": "RBI monetary policy India latest news 2026",
          "weight": 15,
          "sectors": [
            "PSUBank",
            "Realty",
            "Auto",
            "FMCG"
          ]
        },
        "rupee_dollar": {
