  "nse_index_names": {
    "Auto": "NIFTY AUTO",
    "Bank": "NIFTY BANK",
    "Commodities": "NIFTY COMMODITIES",
    "Consumption": "NIFTY INDIA CONSUMPTION",
    "Energy": "NIFTY ENERGY",
    "FinServices": "NIFTY FINANCIAL SERVICES",
    "FMCG": "NIFTY FMCG",
    "Infra": "NIFTY INFRASTRUCTURE",
