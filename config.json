    "MNC"         : "^CNXMNC",
    "Pharma"      : "^CNXPHARMA",
    "PSE"         : "^CNXPSE",
    "PSUBank"     : "^CNXPSUBANK",
    "Realty"      : "^CNXREALTY",
    "Services"    : "^CNXSERVICE"
  },

  "nse_index_names": {
    "Auto"        : "NIFTY AUTO",
    "Bank"        : "NIFTY BANK",
    "Commodities" : "NIFTY COMMODITIES",
    "Consumption" : "NIFTY INDIA CONSUMPTION",
    "Energy"      : "NIFTY ENERGY",
    "FinServices" : "NIFTY FINANCIAL SERVICES",
    "FMCG"        : "NIFTY FMCG",
    "Infra"       : "NIFTY INFRASTRUCTURE",
    "IT"          : "NIFTY IT",
    "Media"       : "NIFTY MEDIA",
    "Metal"       : "NIFTY METAL",
    "MNC"         : "NIFTY MNC",
    "Pharma"      : "NIFTY PHARMA",
    "PSE"         : "NIFTY PSE",
    "PSUBank"     : "NIFTY PSU BANK",
    "Realty"      : "NIFTY REALTY",
    "Services"    : "NIFTY SERVICES SECTOR"
